<mxfile host="app.diagrams.net" agent="Claude Code" version="24.0.0">
  <diagram id="glennsite-arch" name="Hosting architecture">
    <mxGraphModel dx="1800" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1950" pageHeight="1020" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;glennhostetler.com: hosting architecture&lt;/b&gt;&lt;br&gt;Azure Container Apps, Bicep, and GitHub Actions with OIDC (no stored passwords). Solid = deployed, dashed = planned." style="text;html=1;align=left;verticalAlign=top;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="8" width="900" height="44" as="geometry" />
        </mxCell>

        <mxCell id="u1" value="Glenn (developer)" style="image;aspect=fixed;html=1;points=[];fontSize=11;image=img/lib/azure2/identity/Users.svg;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="158" y="84" width="64" height="64" as="geometry" />
        </mxCell>

        <mxCell id="gh" value="GitHub repository (public)&lt;br&gt;main is protected: changes arrive by pull request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#24292F;verticalAlign=top;align=left;spacingLeft=10;fontSize=11;fontStyle=1;container=1;collapsible=0;" vertex="1" parent="1">
